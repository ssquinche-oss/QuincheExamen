<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QuincheExamen.View.LoginPage"
             Title="Login">

    <VerticalStackLayout Padding="20" Spacing="20">

        <Image Source="logo.png" HeightRequest="100" HorizontalOptions="Center"/>

        <Label Text="LOGIN" Style="{StaticResource TituloRojo}"/>

        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,2*" RowSpacing="10" ColumnSpacing="10">
            <Label Text="Usuario" Grid.Row="0" Grid.Column="0" VerticalOptions="Center"/>
            <Entry x:Name="txtUsuario" Placeholder="Ingrese usuario" Grid.Row="0" Grid.Column="1"/>

            <Label Text="Contraseña" Grid.Row="1" Grid.Column="0" VerticalOptions="Center"/>
            <Entry x:Name="txtClave" Placeholder="Ingrese contraseña" IsPassword="True" Grid.Row="1" Grid.Column="1"/>
        </Grid>

        <Button Text="Iniciar sesión" Style="{StaticResource BotonPrincipal}" Clicked="OnIniciarSesion"/>

    </VerticalStackLayout>
</ContentPage>